<mxfile host="app.diagrams.net"><diagram id="workflow" name="Irrigate workflow"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1460" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Irrigate – application workflow" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="40" as="geometry"/></mxCell><mxCell id="L1" value="1 · Account" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;verticalAlign=top;fontStyle=1;fontSize=14;fontColor=#1565c0;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="260" height="690" as="geometry"/></mxCell><mxCell id="L2" value="2 · First-run onboarding" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;verticalAlign=top;fontStyle=1;fontSize=14;fontColor=#2e7d32;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="260" height="690" as="geometry"/></mxCell><mxCell id="L3" value="3 · Dashboard (browser)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;verticalAlign=top;fontStyle=1;fontSize=14;fontColor=#6a1b9a;" vertex="1" parent="1"><mxGeometry x="580" y="70" width="260" height="690" as="geometry"/></mxCell><mxCell id="L4" value="4 · Server loop (every 3 seconds)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;verticalAlign=top;fontStyle=1;fontSize=14;fontColor=#e65100;" vertex="1" parent="1"><mxGeometry x="860" y="70" width="320" height="690" as="geometry"/></mxCell><mxCell id="L5" value="External services &amp; data" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#455a64;verticalAlign=top;fontStyle=1;fontSize=14;fontColor=#455a64;" vertex="1" parent="1"><mxGeometry x="1200" y="70" width="240" height="690" as="geometry"/></mxCell><mxCell id="A1" value="&lt;b&gt;Open Irrigate&lt;/b&gt;&lt;br&gt;GitHub Pages or localhost:5000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1565c0;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="140" width="220" height="64" as="geometry"/></mxCell><mxCell id="A2" value="&lt;b&gt;Signed in?&lt;/b&gt;&lt;br&gt;GET /api/auth/me" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1565c0;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="230" width="220" height="90" as="geometry"/></mxCell><mxCell id="A3" value="&lt;b&gt;Sign up / Log in&lt;/b&gt;&lt;br&gt;password hashed, session cookie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1565c0;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="360" width="220" height="56" as="geometry"/></mxCell><mxCell id="A4" value="&lt;b&gt;Garden set up?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1565c0;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="40.0" y="450" width="220" height="90" as="geometry"/></mxCell><mxCell id="O1" value="&lt;b&gt;Choose plant type&lt;br&gt;and soil type&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d32;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="320.0" y="140" width="220" height="64" as="geometry"/></mxCell><mxCell id="O2" value="&lt;b&gt;Add 1–10 garden locations&lt;/b&gt;&lt;br&gt;UK postcode or phone GPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d32;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="320.0" y="230" width="220" height="64" as="geometry"/></mxCell><mxCell id="O3" value="&lt;b&gt;Set zones for each garden&lt;/b&gt;&lt;br&gt;1–8 named zones, tick “Sheltered”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d32;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="320.0" y="320" width="220" height="64" as="geometry"/></mxCell><mxCell id="O4" value="&lt;b&gt;Save profile&lt;/b&gt;&lt;br&gt;POST /api/onboarding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d32;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="320.0" y="410" width="220" height="64" as="geometry"/></mxCell><mxCell id="D1" value="&lt;b&gt;Dashboard opens&lt;/b&gt;&lt;br&gt;Socket.IO connects; active garden’s zones loaded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6a1b9a;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="600.0" y="140" width="220" height="80" as="geometry"/></mxCell><mxCell id="D3" value="&lt;b&gt;My Profile&lt;/b&gt;&lt;br&gt;switch garden or edit zones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6a1b9a;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="600.0" y="240" width="220" height="64" as="geometry"/></mxCell><mxCell id="D2" value="&lt;b&gt;Manual control&lt;/b&gt;&lt;br&gt;toggle a zone or All ON / OFF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6a1b9a;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="600.0" y="315" width="220" height="64" as="geometry"/></mxCell><mxCell id="D4" value="&lt;b&gt;Settings&lt;/b&gt;&lt;br&gt;pin Manual / Auto, tank &amp;amp; tariff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6a1b9a;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="600.0" y="400" width="220" height="64" as="geometry"/></mxCell><mxCell id="G1" value="&lt;b&gt;Phone GPS&lt;/b&gt; sends location" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6a1b9a;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="600.0" y="490" width="220" height="50" as="geometry"/></mxCell><mxCell id="G2" value="&lt;b&gt;More than 1 mile&lt;br&gt;from garden?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6a1b9a;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="600.0" y="565" width="220" height="100" as="geometry"/></mxCell><mxCell id="S1" value="&lt;b&gt;Fetch weather&lt;/b&gt; for the active garden&lt;br&gt;(cached 10 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e65100;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="890.0" y="140" width="260" height="64" as="geometry"/></mxCell><mxCell id="S2" value="&lt;b&gt;Update soil &amp;amp; tank sensors&lt;/b&gt;&lt;br&gt;(simulated; rain harvest, mains top-up)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e65100;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="890.0" y="230" width="260" height="64" as="geometry"/></mxCell><mxCell id="S0" value="&lt;b&gt;Controller state&lt;/b&gt;&lt;br&gt;mode Auto / Manual + each zone ON / OFF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e65100;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="890.0" y="320" width="260" height="70" as="geometry"/></mxCell><mxCell id="S3" value="&lt;b&gt;Decision engine&lt;/b&gt;&lt;br&gt;• Tank &amp;lt; 10% → stop all zones&lt;br&gt;• Rain, wind &amp;gt; 7 m/s or &amp;gt; 30 °C at midday → skip (sheltered zones still watered in rain)&lt;br&gt;• Auto: water if soil &amp;lt; 40%, stop at 70%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e65100;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="890.0" y="415" width="260" height="120" as="geometry"/></mxCell><mxCell id="S4" value="&lt;b&gt;Alerts&lt;/b&gt; (30-min cooldown)&lt;br&gt;tank low · weather change · soil dry/wet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e65100;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="890.0" y="555" width="260" height="60" as="geometry"/></mxCell><mxCell id="S5" value="&lt;b&gt;Broadcast live state&lt;/b&gt; to dashboards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e65100;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="890.0" y="635" width="260" height="50" as="geometry"/></mxCell><mxCell id="E1" value="&lt;b&gt;OpenWeather&lt;/b&gt;&lt;br&gt;current + 24 h forecast" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#455a64;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1220.0" y="140" width="200" height="56" as="geometry"/></mxCell><mxCell id="E2" value="&lt;b&gt;Open-Meteo&lt;/b&gt;&lt;br&gt;UV index fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#455a64;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1220.0" y="220" width="200" height="56" as="geometry"/></mxCell><mxCell id="E3" value="&lt;b&gt;postcodes.io&lt;/b&gt;&lt;br&gt;postcode → lat / lon&lt;br&gt;(used during onboarding)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#455a64;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1220.0" y="300" width="200" height="64" as="geometry"/></mxCell><mxCell id="E4" value="&lt;b&gt;SQLite database&lt;/b&gt;&lt;br&gt;users · gardens · garden_zones · tank_settings&lt;br&gt;&lt;i&gt;Render’s disk is reset on each redeploy&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#455a64;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1220.0" y="390" width="200" height="110" as="geometry"/></mxCell><mxCell id="e0" style="endArrow=block;endFill=1;html=1;rounded=0;edgeStyle=none;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#37474f;fontSize=10;" edge="1" parent="1" source="A1" target="A2"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e1" style="endArrow=block;endFill=1;html=1;rounded=0;edgeStyle=none;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#37474f;fontSize=10;" edge="1" parent="1" source="A2" target="A3"><mxGeometry relative="1" as="geometry"><Ar